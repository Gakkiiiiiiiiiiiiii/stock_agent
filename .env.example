# Docker Compose 内部默认会覆盖为 postgres/qdrant/redis 服务名；宿主机直连可用 localhost。
POSTGRES_USER=agent
POSTGRES_PASSWORD=change_me_agent_pass
POSTGRES_DB=financial_agent
DATABASE_URL=postgresql://agent:change_me_agent_pass@localhost:5433/financial_agent
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_me_qdrant_key
REDIS_PASSWORD=change_me_redis_pass
REDIS_URL=redis://:change_me_redis_pass@localhost:6379/0
RERANKER_URL=http://localhost:8010
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL_NAME=deepseek-v4-pro
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_API_KEY=your_deepseek_key
# Leave empty to use the documented provider profile; explicit values override it.
AGENT_MODEL_TOOL_CALLING=
AGENT_MODEL_JSON_MODE=
AGENT_MODEL_JSON_SCHEMA=
AGENT_MODEL_VISION=
AGENT_MODEL_STREAMING=
QMT_BRIDGE_PYTHON=../quant/.venv-qmt36/Scripts/python.exe
QMT_BRIDGE_SCRIPT=../quant/scripts/qmt_bridge.py
QMT_INSTALL_DIR=../quant/runtime/qmt_client/installed
QMT_USERDATA_DIR=../quant/runtime/qmt_client/installed/userdata_mini
QMT_BRIDGE_BASE_URL=http://host.docker.internal:18080
QMT_ACCOUNT_ID=
NEWS_DATA_PROVIDER=local
LOG_LEVEL=INFO
ANALYSIS_MODEL_PROVIDER=deepseek
ANALYSIS_MODEL_NAME=deepseek-v4-pro
ANALYSIS_MODEL_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL_API_KEY=your_deepseek_key
ANALYSIS_MODEL_TOOL_CALLING=
ANALYSIS_MODEL_JSON_MODE=
ANALYSIS_MODEL_JSON_SCHEMA=
ANALYSIS_MODEL_VISION=
ANALYSIS_MODEL_STREAMING=
# Kimi K3 可作为视频知识抽取和摘要模型；K3 在兼容 API 下使用 temperature=1。
# ANALYSIS_MODEL_PROVIDER=openai_compatible
# ANALYSIS_MODEL_NAME=k3
# ANALYSIS_MODEL_BASE_URL=https://api.kimi.com/coding/v1
# ANALYSIS_MODEL_API_KEY=your_kimi_key
# ANALYSIS_MODEL_TEMPERATURE=1
# 视觉模型必须是支持 image_url 图片输入的多模态模型（如 qwen-vl-max / glm-4v / gpt-4o）。
# 配置为纯文本模型时视觉环节会自动降级为 OCR 文本复核，并在日志中告警。
VISUAL_MODEL_PROVIDER=deepseek
VISUAL_MODEL_NAME=deepseek-v4-pro
VISUAL_MODEL_BASE_URL=https://api.deepseek.com
VISUAL_MODEL_API_KEY=your_deepseek_key
VISUAL_MODEL_JSON_MODE=
VISUAL_MODEL_JSON_SCHEMA=
VISUAL_MODEL_VISION=
# 部分模型（如 kimi k3）只允许 temperature=1，按需调整
VISUAL_MODEL_TEMPERATURE=0.1
# API / Vector Worker 通过 OpenAI-compatible embedding 服务访问真实语义模型，避免多进程重复加载。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_SERVICE_PROVIDER=sentence_transformers
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CONTENT_STORAGE_DIR=storage/content
BILIBILI_COOKIE_FILE=storage/runtime/bilibili.cookies.txt
BILIBILI_COOKIE_HEADER=
BILIBILI_COOKIES_FROM_BROWSER=
BILIBILI_COOKIES_BROWSER_PROFILE=
ASR_PROVIDER=faster_whisper
# 视频知识入库默认 large-v3（追求实体/数字准确率）；Docker 模式下以 docker-compose.yml 的 environment 为准
ASR_MODEL_SIZE=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_USE_BATCHED=false
ASR_BATCH_SIZE=1
ASR_CHUNK_LENGTH_SECONDS=30
ASR_BEAM_SIZE=5
ASR_BEST_OF=5
ASR_CONDITION_ON_PREVIOUS_TEXT=true
# ASR 引导词：简体中文金融词汇，可提升术语准确率并抑制繁体输出；留空使用内置默认值
ASR_INITIAL_PROMPT=
FFMPEG_BIN=ffmpeg
YT_DLP_BIN=yt-dlp
TESSERACT_BIN=tesseract
# paddleocr=本地 PaddleOCR 识别画面文字；none=禁用本地 OCR，仅用多模态视觉模型解析画面
VIDEO_OCR_BACKEND=paddleocr
VIDEO_OCR_LANGUAGE=chi_sim+eng
VIDEO_OCR_PADDLE_LANG=ch
VIDEO_OCR_DEVICE=auto
VIDEO_OCR_SCORE_THRESH=0.75
VIDEO_OCR_DET_MODEL_NAME=PP-OCRv5_server_det
VIDEO_OCR_REC_MODEL_NAME=PP-OCRv5_server_rec
VIDEO_FRAME_INTERVAL_SECONDS=15
VIDEO_MAX_FRAMES=18
VIDEO_VISUAL_CUE_WINDOW_SECONDS=3
VIDEO_VISUAL_TRANSCRIPT_WINDOW_SECONDS=12
VIDEO_VISUAL_MAX_CONTEXT_ITEMS=10
VIDEO_VISION_MAX_FRAMES=12
VIDEO_VISION_TEXT_FALLBACK=1
# 单个视频最多用 LLM 做事件抽取的分块数（0 表示不限制），超出部分回退为规则抽取
VIDEO_EVENT_LLM_MAX_CHUNKS=40
# 外部事实核验：启用后 PRICE_LEVEL/VALUATION/FINANCIAL_METRIC 经 QMT 桥做外部核验；
# QMT 离线时安全降级 NOT_RUN/ERROR，绝不静默 MATCH；公告/政策类暂不支持外部核验
VIDEO_EXTERNAL_FACT_VERIFICATION=1
# pyannote 说话人分离 token；代码读取顺序：PYANNOTE_TOKEN → HF_TOKEN → HUGGINGFACE_TOKEN
PYANNOTE_TOKEN=
# 可选：HuggingFace 通用 token，仅当 PYANNOTE_TOKEN 为空时回退使用
# HF_TOKEN=
CONTENT_MAX_AUDIO_MINUTES=180
# 自动因子挖掘（AlphaGPT 式，样本内评估）
FACTOR_MINING_ROUNDS=3
FACTOR_MINING_CANDIDATES_PER_ROUND=8
FACTOR_MINING_HORIZON_DAYS=5
FACTOR_MINING_MAX_CANDIDATES=40
# 前向模拟盘：距上次挖掘满 N 个交易日重挖一次
FACTOR_PAPER_REMINE_DAYS=5
# iFinD 低频缓存有效期
IFIND_CACHE_TTL_DAYS=7
CONTENT_BACKEND=local
CONTENT_SERVICE_URL=http://stock-content:8100
FACTOR_BACKEND=local
FACTOR_SERVICE_URL=http://stock-factor:8200
