{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge conclusion Golden manifest",
  "type": "object",
  "required": ["schema_version", "partitions", "thresholds", "lineage"],
  "properties": {
    "schema_version": {"const": "knowledge-conclusion-golden.v1"},
    "partitions": {
      "type": "object",
      "required": ["train", "dev", "frozen_oos"],
      "properties": {
        "train": {"$ref": "#/$defs/partition"},
        "dev": {"$ref": "#/$defs/partition"},
        "frozen_oos": {"$ref": "#/$defs/partition"}
      }
    },
    "thresholds": {"type": "object"},
    "lineage": {"type": "object"}
  },
  "$defs": {
    "partition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "path", "sha256"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^cases/.+\\.json$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
