{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "authority", "envelope_id", "decision_id", "decision_snapshot_id", "portfolio_id", "allowed_actions", "max_notional", "valid_until", "contract_checksums"],
  "properties": {
    "contract": {"const": "execution-authorization.v1"},
    "authority": {"const": "FORMAL"},
    "envelope_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_snapshot_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "max_notional": {"type": "number", "minimum": 0},
    "valid_until": {"type": "string", "format": "date-time"},
    "contract_checksums": {"type": "object", "minProperties": 1}
  }
}
