{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-conclusion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "conclusion_id", "scope", "execution_eligible", "query", "content_bundle_id", "content_snapshot_id", "verdict", "market_stance", "summary", "findings", "conditions", "risks", "contradictions", "limitations", "model", "created_at"],
  "$defs": {
    "safeText": {
      "type": "string",
      "minLength": 1,
      "description": "Content-only research narrative. Direct trading, position, execution, stop/target, or recommendation language is prohibited. This portable deny list is intentionally coarse; the Agent domain validator is authoritative and additionally normalizes Unicode, case, and punctuation before inspecting every displayed string.",
      "allOf": [
        {"not": {"pattern": "(?i)\\b(?:buy|sell|hold|go\\s+long|go\\s+short|open\\s+(?:a\\s+|the\\s+|your\\s+)?(?:long|short|position|trade|exposure|holding)|close\\s+(?:a\\s+|the\\s+|your\\s+)?(?:long|short|position|trade|exposure|holding)|enter\\s+(?:a\\s+|the\\s+|your\\s+)?(?:position|trade)|exit\\s+(?:a\\s+|the\\s+|your\\s+)?(?:position|trade)|(?:enter|exit|open|close|clear|liquidate|hold)\\s+(?:now|immediately|today)|clear\\s+(?:the\\s+|your\\s+)?(?:position|holding)|liquidate\\s+(?:the\\s+|your\\s+)?(?:position|holding)|stop\\s*loss|take\\s*profit|take\\s+profits?\\s+(?:now|immediately|today)|set\\s+(?:a\\s+|the\\s+|your\\s+)?stop(?:\\s+at)?|target\\s*price|price\\s*target|order\\s*command|execution\\s*authorization|broker)\\b"}},
        {"not": {"pattern": "买入|卖出|建仓|开仓|平仓|清仓|加仓|减仓|补仓|做多|做空|入场|离场|进场|出场|退出交易|仓位指令|止损|止盈|止赚|目标价|目标价格"}}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "knowledge_ids", "evidence_ids", "confidence"],
      "properties": {
        "text": {"$ref": "#/$defs/safeText"},
        "knowledge_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "properties": {
    "contract": {"const": "knowledge-conclusion.v1"},
    "conclusion_id": {"type": "string", "minLength": 1},
    "scope": {"const": "CONTENT_ONLY_RESEARCH"},
    "execution_eligible": {"const": false},
    "query": {"$ref": "#/$defs/safeText"},
    "content_bundle_id": {"type": "string", "minLength": 1},
    "content_snapshot_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["SUPPORTED", "CONTRADICTED", "MIXED", "INSUFFICIENT_EVIDENCE"]},
    "market_stance": {"enum": ["BULLISH", "BEARISH", "NEUTRAL", "UNCERTAIN"]},
    "summary": {"$ref": "#/$defs/safeText"},
    "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/safeText"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/safeText"}},
    "contradictions": {"type": "array", "items": {"$ref": "#/$defs/safeText"}},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/safeText"}},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provider", "model", "prompt_version"],
      "properties": {
        "mode": {"enum": ["MODEL", "FALLBACK"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"const": "knowledge-conclusion.prompt.v1"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
