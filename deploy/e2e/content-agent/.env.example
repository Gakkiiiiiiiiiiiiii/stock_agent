# Copy to .env. Use a unique namespace per run; Docker does not clean volumes
# automatically. The documented workspace has stock_agent/ and stock_content/ siblings.
COMPOSE_PROJECT_NAME=content-agent-fixture
COMPOSE_PROFILES=fixture
STOCK_CONTENT_CONTEXT=../../../../stock_content
# Candidate metadata refers to the prepared base commits only.  Do not replace
# either value with an uncommitted worktree revision or call it exact-ref.
STOCK_CONTENT_SERVICE_VERSION=0.0.0-candidate
STOCK_CONTENT_GIT_COMMIT=bfc7f9be6b03f3189d2d316934e31a299e36047c
STOCK_CONTENT_PIPELINE_VERSION=video-knowledge-pipeline.v1
STOCK_AGENT_GIT_COMMIT=96f63d8a56567ce1b60788f0d59880472268b74c

# The fixture token is intentionally non-production and is kept outside this
# file. Override each path with a read-only Docker secret file for authorized
# Bilibili, Xiaoe, or full-model runs. Do not put token/cookie/key values here.
# CONTENT_SERVICE_API_KEY_HOST_FILE=/absolute/path/content-service-current.token
# CONTENT_SERVICE_API_KEY_PREVIOUS_HOST_FILE=/absolute/path/content-service-previous.token
# CONTENT_BILIBILI_COOKIEFILE_HOST_FILE=/absolute/path/bilibili.cookie
# CONTENT_XIAOE_HLS_LOCATOR_HOST_FILE=/absolute/path/xiaoe-hls-locator.txt
# CONTENT_XIAOE_STORAGE_STATE_HOST_FILE=/absolute/path/xiaoe-storage-state.json
# CONTENT_MODEL_API_KEY_HOST_FILE=/absolute/path/content-model-api-key

# Content's full-model is opt-in and requires a configured endpoint/name plus
# the key file above.  The Agent has no HTTP model-provider adapter in this
# packet: its readiness remains degraded and it uses deterministic fallback.
# An external provider adapter must be injected and tested before changing that
# claim.  The fixture profile deliberately keeps the fallback enabled.
# CONTENT_MODEL_URL=https://model.example/v1/chat/completions
# CONTENT_MODEL_NAME=approved-structured-model
# KNOWLEDGE_CONCLUSION_DETERMINISTIC_FALLBACK=false

# Public Bilibili omits credential_ref.  An authorized Bilibili run supplies
# only the cookie-file path above and uses the fixed `bilibili-cookiefile`
# reference (never cookie bytes).  Direct Xiaoe HLS likewise submits the fixed
# `xiaoe-hls-locator` reference; the signed locator remains only in its file.
# Xiaoe page mode is opt-in: use only an authorized page template and the
# storage-state secret file above.  No profile bypasses login, paywall, region,
# or DRM controls.
# CONTENT_BILIBILI_CREDENTIAL_REF=bilibili-cookiefile
# CONTENT_XIAOE_HLS_CREDENTIAL_REF=xiaoe-hls-locator
# CONTENT_XIAOE_CREDENTIAL_REF=xiaoe-storage-state
# CONTENT_XIAOE_PAGE_RESOLVER_ENABLED=true
# CONTENT_XIAOE_PAGE_URL_TEMPLATE=https://m.xiaoe-tech.com/detail/{source_ref}
